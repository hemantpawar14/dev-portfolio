<div class="relative overflow-hidden">

  <img
    src={image}
    alt={title}
    class="h-56 w-full object-cover transition duration-500 group-hover:scale-110"
  />

  <!-- Dark Gradient -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>

  <!-- Category -->
  <span
    class="absolute left-5 top-5 rounded-full bg-blue-600 px-3 py-1 text-xs font-semibold uppercase text-white"
  >
    {category}
  </span>

  <!-- Featured Badge -->
  {
    featured && (
      <span
        class="absolute right-5 top-5 rounded-full bg-amber-500 px-3 py-1 text-xs font-semibold text-black"
      >
        ⭐ Featured
      </span>
    )
  }

</div>