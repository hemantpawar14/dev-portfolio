---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  icon: string;
  description: string;
}

const { name, icon, description } = Astro.props;
---

<div
  class="group rounded-2xl border border-slate-800 bg-slate-900/40 p-6 transition-all duration-300 hover:-translate-y-2 hover:border-blue-500 hover:shadow-lg hover:shadow-blue-500/10"
>
  <Icon
    name={icon}
    class="mb-5 h-12 w-12 transition-transform duration-300 group-hover:scale-110"
  />

  <h3 class="mb-2 text-lg font-semibold text-white">
    {name}
  </h3>

  <p class="text-sm leading-6 text-slate-400">
    {description}
  </p>
</div>