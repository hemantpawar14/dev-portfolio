---
import { featuredProjects } from "../../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<section id="projects" class="container-custom py-32">

  <div class="mb-16 text-center">

    <span
      class="text-sm font-semibold uppercase tracking-[0.3em] text-blue-400"
    >
      FEATURED PROJECTS
    </span>

    <h2 class="mt-5 text-4xl font-bold text-white md:text-5xl">
      Things I've Built
    </h2>

    <p class="mx-auto mt-6 max-w-3xl text-lg text-slate-400">
      A collection of hands-on Linux, Cloud, Networking and DevOps
      projects built while learning and practicing real-world concepts.
    </p>

  </div>

  <div class="grid gap-10 md:grid-cols-2 xl:grid-cols-3">

    {
      featuredProjects.map((project) => (
        <ProjectCard {...project} />
      ))
    }

  </div>

</section>