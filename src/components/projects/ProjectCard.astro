---
interface Props {
  title: string;
  description: string;
  image: string;
  github: string;
  live?: string;
  technologies: string[];
}

const {
  title,
  description,
  image,
  github,
  live,
  technologies,
} = Astro.props;
---

<div
  class="group overflow-hidden rounded-3xl border border-slate-800 bg-slate-900/60 backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-blue-500 hover:shadow-2xl hover:shadow-blue-500/20"
>
  <!-- Project Image -->
  <div class="overflow-hidden">
    <img
      src={image}
      alt={title}
      class="h-56 w-full object-cover transition duration-500 group-hover:scale-105"
    />
  </div>

  <!-- Content -->
  <div class="space-y-5 p-6">

    <h3 class="text-2xl font-bold text-white">
      {title}
    </h3>

    <p class="text-slate-400 leading-7">
      {description}
    </p>

    <!-- Tech Tags -->
    <div class="flex flex-wrap gap-2">
      {
        technologies.map((tech) => (
          <span
            class="rounded-full bg-blue-500/10 px-3 py-1 text-sm text-blue-400 border border-blue-500/20"
          >
            {tech}
          </span>
        ))
      }
    </div>

    <!-- Buttons -->
    <div class="flex gap-4 pt-2">

      <a
        href={github}
        target="_blank"
        class="rounded-lg bg-blue-600 px-5 py-2 text-white transition hover:bg-blue-700"
      >
        GitHub
      </a>

      {
        live && (
          <a
            href={live}
            target="_blank"
            class="rounded-lg border border-slate-700 px-5 py-2 text-white transition hover:border-blue-500"
          >
            Live Demo
          </a>
        )
      }

    </div>

  </div>
</div>