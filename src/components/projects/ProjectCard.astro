---
interface Props {
  title: string;
  description: string;
  image: string;
  github: string;
  live?: string;
  technologies: string[];
  category: string;
  featured?: boolean;
}

const {
  title,
  description,
  image,
  github,
  live,
  technologies,
  category,
  featured,
} = Astro.props;
---

<div
  class="group overflow-hidden rounded-3xl border border-slate-800 bg-slate-900/60 transition-all duration-500 hover:-translate-y-3 hover:border-blue-500 hover:shadow-2xl hover:shadow-blue-500/20"
>

  <!-- Project Image -->
  <div class="relative overflow-hidden">

    <img
      src={image}
      alt={title}
      class="h-56 w-full object-cover transition duration-500 group-hover:scale-110"
    />

    <!-- Gradient Overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"
    ></div>

    <!-- Category Badge -->
    <span
      class="absolute left-4 top-4 rounded-full bg-blue-600 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white"
    >
      {category}
    </span>

    <!-- Featured Badge -->
    {
      featured && (
        <span
          class="absolute right-4 top-4 rounded-full bg-amber-400 px-3 py-1 text-xs font-bold text-black"
        >
          ⭐ Featured
        </span>
      )
    }

  </div>

  <!-- Content -->
  <div class="space-y-5 p-6">

    <h3 class="text-2xl font-bold text-white">
      {title}
    </h3>

    <p class="leading-7 text-slate-400">
      {description}
    </p>

    <!-- Tech Tags -->
    <div class="flex flex-wrap gap-2">
      {
        technologies.map((tech) => (
          <span
            class="rounded-full border border-slate-700 bg-slate-800 px-3 py-1 text-xs font-medium text-slate-300 transition duration-300 hover:border-blue-500 hover:text-blue-400"
          >
            {tech}
          </span>
        ))
      }
    </div>

    <!-- Buttons -->
    <div class="flex gap-4 pt-2">

      <a
        href={github}
        target="_blank"
        class="rounded-xl bg-blue-600 px-5 py-2 font-medium text-white transition duration-300 hover:bg-blue-700"
      >
        GitHub →
      </a>

      {
        live && (
          <a
            href={live}
            target="_blank"
            class="rounded-xl border border-slate-700 px-5 py-2 font-medium text-white transition duration-300 hover:border-blue-500"
          >
            Live Demo
          </a>
        )
      }

    </div>

  </div>

</div>