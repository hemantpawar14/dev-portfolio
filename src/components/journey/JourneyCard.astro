---
interface Props {
  title: string;
  icon: string;
  status: "completed" | "current" | "planned";
  description: string;
  topics: string[];
}

const {
  title,
  icon,
  status,
  description,
  topics,
} = Astro.props;

const statusStyles = {
  completed: {
    badge: "bg-emerald-500/20 text-emerald-400 border-emerald-500/30",
    label: "Completed",
  },
  current: {
    badge: "bg-blue-500/20 text-blue-400 border-blue-500/30",
    label: "In Progress",
  },
  planned: {
    badge: "bg-slate-700 text-slate-300 border-slate-600",
    label: "Planned",
  },
};
---

<div
  class="group w-80 flex-shrink-0 rounded-3xl border border-slate-800 bg-slate-900/60 p-6 transition-all duration-500 hover:-translate-y-2 hover:border-blue-500 hover:shadow-2xl hover:shadow-blue-500/20"
>

  <!-- Icon -->
  <div class="mb-5 text-5xl transition-transform duration-300 group-hover:scale-110">
    {icon}
  </div>

  <!-- Title -->
  <h3 class="text-2xl font-bold text-white">
    {title}
  </h3>

  <!-- Status -->
  <span
    class={`mt-4 inline-flex rounded-full border px-3 py-1 text-sm font-medium ${statusStyles[status].badge}`}
  >
    {statusStyles[status].label}
  </span>

  <!-- Description -->
  <p class="mt-5 leading-7 text-slate-400">
    {description}
  </p>

  <!-- Topics -->
  <ul class="mt-6 space-y-2">
    {
      topics.slice(0, 4).map((topic) => (
        <li class="flex items-center gap-2 text-sm text-slate-300">
          <span class="text-blue-400">•</span>
          {topic}
        </li>
      ))
    }
  </ul>

</div>