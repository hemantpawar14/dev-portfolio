---
interface Props {
  title: string;
  icon: string;
  status: "completed" | "current" | "planned";
  description: string;
  topics: string[];
}

const {
  title,
  icon,
  status,
  description,
  topics,
} = Astro.props;

const statusStyles = {
  completed: {
    badge: "bg-emerald-500/20 text-emerald-400 border-emerald-500/30",
    label: "Completed",
  },
  current: {
    badge: "bg-blue-500/20 text-blue-400 border-blue-500/30",
    label: "In Progress",
  },
  planned: {
    badge: "bg-slate-700/50 text-slate-300 border-slate-600",
    label: "Planned",
  },
};
---

<div
  class="group w-[300px] sm:w-[340px] flex-shrink-0 rounded-3xl border border-slate-800/80 bg-slate-900/60 p-6 backdrop-blur-sm transition-all duration-500 hover:-translate-y-2 hover:border-cyan-400 hover:bg-slate-900/80 hover:shadow-xl hover:shadow-cyan-500/10"
>

  <!-- Icon -->

  <div
    class="mb-6 text-5xl transition-transform duration-300 group-hover:scale-110"
  >
    {icon}
  </div>

  <!-- Title -->

  <h3
    class="text-xl font-bold text-white sm:text-2xl"
  >
    {title}
  </h3>

  <!-- Status -->

  <span
    class={`mt-4 inline-flex rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-wide ${statusStyles[status].badge}`}
  >
    {statusStyles[status].label}
  </span>

  <!-- Description -->

  <p
    class="mt-5 text-sm leading-7 text-slate-400 sm:text-base"
  >
    {description}
  </p>

  <!-- Topics -->

  <ul class="mt-6 space-y-3">

    {
      topics.slice(0, 4).map((topic) => (
        <li class="flex items-center gap-3 text-sm text-slate-300">

          <span
            class="h-2 w-2 rounded-full bg-cyan-400"
          ></span>

          <span>{topic}</span>

        </li>
      ))
    }

  </ul>

</div>