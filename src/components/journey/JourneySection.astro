---
import { journey } from "../../data/journey";
import JourneyCard from "./JourneyCard.astro";
---

<section
  id="journey"
  class="container-custom py-20 sm:py-24 lg:py-32"
>

  <!-- Heading -->

  <div class="mx-auto mb-16 max-w-4xl text-center">

    <span
      class="text-xs font-semibold uppercase tracking-[0.35em] text-cyan-400 sm:text-sm"
    >
      CLOUD & DEVOPS JOURNEY
    </span>

    <h2
      class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
    >
      My Learning Roadmap
    </h2>

    <p
      class="mx-auto mt-6 max-w-3xl text-base leading-7 text-slate-400 sm:text-lg sm:leading-8"
    >
      Every milestone represents a step toward becoming a Cloud &
      DevOps Engineer through consistent hands-on learning,
      practical projects, and continuous improvement.
    </p>

  </div>

  <!-- Timeline -->

  <div
    class="overflow-x-auto scroll-smooth snap-x snap-mandatory pb-6"
  >

    <div
      class="flex min-w-max items-center gap-6 lg:gap-8"
    >

      {
        journey.map((step, index) => (
          <>
            <div class="snap-center">
              <JourneyCard {...step} />
            </div>

            {
              index !== journey.length - 1 && (
                <div
                  class="hidden h-1 w-20 rounded-full bg-gradient-to-r from-blue-500 via-cyan-400 to-blue-500 lg:block"
                ></div>
              )
            }
          </>
        ))
      }

    </div>

  </div>

</section>

<style>
  div::-webkit-scrollbar {
    display: none;
  }

  div {
    scrollbar-width: none;
  }
</style>