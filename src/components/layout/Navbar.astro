
---
const navLinks = [
  { name: "Home", href: "#top" },
  { name: "Projects", href: "#projects" },
  { name: "Certificates", href: "#certifications" },
  { name: "Journey", href: "#journey" },
  { name: "Contact", href: "#contact" },
];

---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-slate-950/70 backdrop-blur-xl"
>
  <nav class="container-custom flex h-20 items-center justify-between">

    <!-- Logo -->
    <a
      href="/"
      class="text-2xl font-bold tracking-tight text-white transition hover:text-cyan-400"
    >
      Hemant<span class="text-cyan-400">.</span>
    </a>

    <!-- Desktop Navigation -->
    <ul class="hidden items-center gap-8 text-sm font-medium text-slate-300 lg:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="transition-colors duration-300 hover:text-cyan-400"
            >
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Desktop GitHub -->
    <a
      href="https://github.com/hemantpawar14"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 px-5 py-2.5 font-medium text-white transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-cyan-500/20 lg:inline-flex"
    >
      GitHub
    </a>

    <!-- Mobile Menu Button -->
    <button
      id="menu-btn"
      class="rounded-lg border border-slate-700 p-2 text-white transition hover:border-cyan-400 lg:hidden"
      aria-label="Toggle menu"
    >
      ☰
    </button>

  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-slate-800 bg-slate-950/95 backdrop-blur-xl lg:hidden"
  >
    <div class="container-custom flex flex-col py-6">

      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3 py-3 text-slate-300 transition hover:bg-slate-900 hover:text-cyan-400"
          >
            {link.name}
          </a>
        ))
      }

      <a
        href="https://github.com/hemantpawar14"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 px-5 py-3 text-center font-medium text-white"
      >
        GitHub
      </a>

    </div>
  </div>
</header>

<script>
  const button = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");

  button?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>