---
const navLinks = [
  { name: "Home", href: "/" },
  { name: "Projects", href: "/projects" },
  { name: "Linux", href: "/linux" },
  { name: "Blog", href: "/blog" },
  { name: "Certificates", href: "/certifications" },
  { name: "About", href: "/about" },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-slate-950/70 backdrop-blur-xl"
>
  <nav class="container-custom flex h-20 items-center justify-between">

    <!-- Logo -->
    <a
      href="/"
      class="text-2xl font-bold tracking-tight text-white transition hover:text-blue-400"
    >
      Hemant<span class="text-blue-500">.</span>
    </a>

    <!-- Navigation -->
    <ul class="hidden items-center gap-8 text-sm font-medium text-slate-300 md:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="transition-colors duration-300 hover:text-blue-400"
            >
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- GitHub Button -->
    <a
      href="https://github.com/hemantpawar14"
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-xl bg-blue-600 px-5 py-2.5 font-medium text-white shadow-lg shadow-blue-600/20 transition-all duration-300 hover:-translate-y-0.5 hover:bg-blue-500 hover:shadow-blue-500/40"
    >
      GitHub
    </a>

  </nav>
</header>