---
import { portfolio } from "../../data/portfolio";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-slate-800 bg-slate-950">

  <div class="container-custom py-16">

    <!-- Top -->

    <div class="grid gap-12 md:grid-cols-3">

      <!-- Brand -->

      <div>

        <h3 class="text-2xl font-bold text-white">
          Hemant<span class="text-cyan-400">.</span>
        </h3>

        <p class="mt-3 text-slate-400">
          Cloud & DevOps Engineer
        </p>

        <p class="mt-6 max-w-sm leading-7 text-slate-500">
          Passionate about Linux, AWS, Docker, Kubernetes,
          Terraform, automation, and building reliable cloud
          infrastructure through hands-on projects.
        </p>

      </div>

      <!-- Navigation -->

      <div>

        <h4 class="mb-5 text-lg font-semibold text-white">
          Quick Links
        </h4>

        <ul class="space-y-3">

          <li>
            <a href="/" class="text-slate-400 transition hover:text-cyan-400">
              Home
            </a>
          </li>

          <li>
            <a href="/projects" class="text-slate-400 transition hover:text-cyan-400">
              Projects
            </a>
          </li>

          <li>
            <a href="/certifications" class="text-slate-400 transition hover:text-cyan-400">
              Certifications
            </a>
          </li>

          <li>
            <a href="/about" class="text-slate-400 transition hover:text-cyan-400">
              About
            </a>
          </li>

          <li>
            <a href="#contact" class="text-slate-400 transition hover:text-cyan-400">
              Contact
            </a>
          </li>

        </ul>

      </div>

      <!-- Connect -->

      <div>

        <h4 class="mb-5 text-lg font-semibold text-white">
          Connect
        </h4>

        <div class="space-y-3">

          <a
            href={portfolio.github}
            target="_blank"
            rel="noopener noreferrer"
            class="block text-slate-400 transition hover:text-cyan-400"
          >
            GitHub ↗
          </a>

          <a
            href={portfolio.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="block text-slate-400 transition hover:text-cyan-400"
          >
            LinkedIn ↗
          </a>

          <a
            href={`mailto:${portfolio.email}`}
            class="block break-all text-slate-400 transition hover:text-cyan-400"
          >
            {portfolio.email}
          </a>

        </div>

      </div>

    </div>

    <!-- Divider -->

    <div class="my-10 border-t border-slate-800"></div>

    <!-- Bottom -->

    <div
      class="flex flex-col items-center justify-between gap-6 text-center md:flex-row md:text-left"
    >

      <p class="text-sm text-slate-500">
        © {year} Hemant Pawar. All rights reserved.
      </p>

      <p class="text-sm text-slate-500">
        Built with Astro • Tailwind CSS • ❤️
      </p>

      <a
        href="#top"
        class="rounded-full border border-slate-700 px-4 py-2 text-sm text-slate-400 transition hover:border-cyan-400 hover:text-white"
      >
        ↑ Back to Top
      </a>

    </div>

  </div>

</footer>