---
import { portfolio } from "../../data/portfolio";
---

<section id="contact" class="py-28">

  <div class="container-custom">

    <!-- Heading -->

    <div class="mx-auto max-w-3xl text-center">

      <p class="mb-4 font-semibold uppercase tracking-[0.3em] text-cyan-400">
        CONTACT
      </p>

      <h2 class="text-4xl font-bold text-white md:text-5xl">
        Let's Build Something Great
      </h2>

      <p class="mt-6 text-lg leading-8 text-slate-400">
        I'm always open to internship opportunities, collaborations,
        open-source contributions, and conversations about Cloud &
        DevOps.
      </p>

    </div>

    <!-- Cards -->

    <div class="mt-16 grid gap-6 md:grid-cols-2">

      <!-- Email -->

      <a
        href={`mailto:${portfolio.email}`}
        class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition duration-300 hover:border-cyan-400 hover:-translate-y-1"
      >

        <div class="text-3xl">📧</div>

        <h3 class="mt-4 text-xl font-semibold text-white">
          Email
        </h3>

        <p class="mt-2 text-slate-400">
          {portfolio.email}
        </p>

      </a>

      <!-- LinkedIn -->

      <a
        href={portfolio.linkedin}
        target="_blank"
        class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition duration-300 hover:border-cyan-400 hover:-translate-y-1"
      >

        <div class="text-3xl">💼</div>

        <h3 class="mt-4 text-xl font-semibold text-white">
          LinkedIn
        </h3>

        <p class="mt-2 text-slate-400">
          Connect with me
        </p>

      </a>

      <!-- GitHub -->

      <a
        href={portfolio.github}
        target="_blank"
        class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition duration-300 hover:border-cyan-400 hover:-translate-y-1"
      >

        <div class="text-3xl">💻</div>

        <h3 class="mt-4 text-xl font-semibold text-white">
          GitHub
        </h3>

        <p class="mt-2 text-slate-400">
          View my repositories
        </p>

      </a>

      <!-- Location -->

      <div
        class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6"
      >

        <div class="text-3xl">📍</div>

        <h3 class="mt-4 text-xl font-semibold text-white">
          Location
        </h3>

        <p class="mt-2 text-slate-400">
          {portfolio.location}
        </p>

      </div>

    </div>

    <!-- Buttons -->

    <div class="mt-14 flex flex-wrap justify-center gap-5">

      <a
        href={`mailto:${portfolio.email}`}
        class="rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 px-8 py-4 font-semibold text-white transition duration-300 hover:-translate-y-1"
      >
        📧 Email Me
      </a>

      <a
        href="/resume/resume.pdf"
        target="_blank"
        class="rounded-xl border border-slate-700 px-8 py-4 font-semibold text-white transition duration-300 hover:border-cyan-400 hover:bg-slate-900"
      >
        📄 Download Resume
      </a>

    </div>

  </div>

</section>