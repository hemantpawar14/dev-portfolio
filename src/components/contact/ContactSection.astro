---
import { portfolio } from "../../data/portfolio";
---

<section
  id="contact"
  class="container-custom py-20 sm:py-24 lg:py-32"
>

  <!-- Heading -->

  <div class="mx-auto max-w-3xl text-center">

    <span
      class="text-xs font-semibold uppercase tracking-[0.35em] text-cyan-400 sm:text-sm"
    >
      CONTACT
    </span>

    <h2
      class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
    >
      Let's Build Something Great
    </h2>

    <p
      class="mx-auto mt-6 max-w-2xl text-base leading-7 text-slate-400 sm:text-lg sm:leading-8"
    >
      I'm always open to internships, freelance opportunities,
      collaborations, and conversations about Cloud & DevOps.
    </p>

  </div>

  <!-- Contact Cards -->

  <div
    class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4"
  >

    <!-- Email -->

    <a
      href={`mailto:${portfolio.email}`}
      class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400 hover:shadow-lg hover:shadow-cyan-500/10"
    >
      <div class="text-3xl">📧</div>

      <h3 class="mt-4 text-lg font-semibold text-white">
        Email
      </h3>

      <p class="mt-2 break-all text-sm text-slate-400">
        {portfolio.email}
      </p>
    </a>

    <!-- GitHub -->

    <a
      href={portfolio.github}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400 hover:shadow-lg hover:shadow-cyan-500/10"
    >
      <div class="text-3xl">💻</div>

      <h3 class="mt-4 text-lg font-semibold text-white">
        GitHub
      </h3>

      <p class="mt-2 text-sm text-slate-400">
        github.com/hemantpawar14
      </p>
    </a>

    <!-- LinkedIn -->

    <a
      href={portfolio.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400 hover:shadow-lg hover:shadow-cyan-500/10"
    >
      <div class="text-3xl">💼</div>

      <h3 class="mt-4 text-lg font-semibold text-white">
        LinkedIn
      </h3>

      <p class="mt-2 text-sm text-slate-400">
        Connect with me
      </p>
    </a>

    <!-- Location -->

    <div
      class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6"
    >
      <div class="text-3xl">📍</div>

      <h3 class="mt-4 text-lg font-semibold text-white">
        Location
      </h3>

      <p class="mt-2 text-sm text-slate-400">
        {portfolio.location}
      </p>
    </div>

  </div>

  <!-- CTA Buttons -->

  <div
    class="mt-14 flex flex-col items-center justify-center gap-4 sm:flex-row"
  >

    <a
      href={`mailto:${portfolio.email}`}
      class="w-full rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 px-8 py-4 text-center font-semibold text-white transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-cyan-500/20 sm:w-auto"
    >
      📧 Email Me
    </a>

    <a
      href="/resume/resume.pdf"
      target="_blank"
      class="w-full rounded-xl border border-slate-700 px-8 py-4 text-center font-semibold text-white transition-all duration-300 hover:border-cyan-400 hover:bg-slate-900 sm:w-auto"
    >
      📄 Download Resume
    </a>

  </div>

</section>