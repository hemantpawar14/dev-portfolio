---
const skills = [
  "🐧 Linux",
  "🌿 Git",
  "🐙 GitHub",
  "🐳 Docker",
  "☁️ AWS",
  "🏗️ Terraform",
  "☸️ Kubernetes",
  "⚡ GitHub Actions",
];
---

<div class="mt-12 flex flex-wrap gap-4">
  {
    skills.map((skill) => (
      <span
        class="rounded-full border border-slate-700/70 bg-slate-900/50 px-5 py-3 text-sm font-medium text-slate-300 backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400 hover:text-white hover:shadow-lg hover:shadow-cyan-500/20"
      >
        {skill}
      </span>
    ))
  }
</div>