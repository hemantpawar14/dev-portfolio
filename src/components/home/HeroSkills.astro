---

const skills = [
  "Linux",
  "Git",
  "GitHub",
  "Docker",
  "AWS",
  "Terraform",
  "Kubernetes",
  "GitHub Actions"
];

---

<div class="mt-12 flex flex-wrap gap-3">
  {
    skills.map(skill => (
      <span
        class="rounded-full border border-slate-700 bg-slate-900/60 px-5 py-2 text-sm text-slate-300 transition-all duration-300 hover:-translate-y-1 hover:border-blue-500 hover:text-white"
      >
        {skill}
      </span>
    ))
  }
</div>