---
import { portfolio } from "../../data/portfolio";
---

<div
  class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center"
>

  <!-- Primary Button -->
  <a
    href="/projects"
    class="group inline-flex items-center gap-3 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 px-8 py-4 font-semibold text-white shadow-lg shadow-blue-500/25 transition-all duration-300 hover:-translate-y-1 hover:shadow-blue-500/50"
  >
    <span>🚀</span>

    <span>View Projects</span>

    <span class="transition-transform duration-300 group-hover:translate-x-1">
      →
    </span>
  </a>

  <!-- Secondary Button -->
  <a
    href="/resume/Hemant_Pawar_ressume_updated.pdf"
    target="_blank"
    class="group inline-flex items-center gap-3 rounded-xl border border-slate-700 bg-slate-900/50 px-8 py-4 font-semibold text-white backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:border-cyan-500 hover:bg-slate-800"
  >
    <span>📄</span>

    <span>Download Resume</span>

    <span class="transition-transform duration-300 group-hover:translate-y-[2px]">
      ↓
    </span>
  </a>

  <!-- GitHub Button -->
  <a
    href={portfolio.github}
    target="_blank"
    class="group inline-flex items-center gap-3 rounded-xl border border-slate-700 bg-slate-900/50 px-8 py-4 font-semibold text-white backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:border-white hover:bg-slate-800"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-5 w-5 transition-transform duration-300 group-hover:rotate-12"
      fill="currentColor"
      viewBox="0 0 24 24"
    >
      <path d="M12 .5C5.65.5.5 5.65.5 12A11.5 11.5 0 008.36 22.9c.58.1.79-.25.79-.56v-2.1c-3.2.69-3.87-1.36-3.87-1.36-.52-1.3-1.27-1.64-1.27-1.64-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.76 2.69 1.25 3.35.95.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.27-5.23-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.17 1.17a10.98 10.98 0 015.78 0c2.2-1.48 3.17-1.17 3.17-1.17.62 1.59.23 2.77.11 3.06.74.8 1.18 1.82 1.18 3.07 0 4.4-2.68 5.36-5.24 5.65.41.36.78 1.08.78 2.18v3.24c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/>
    </svg>

    <span>GitHub</span>

    <span class="transition-transform duration-300 group-hover:translate-x-1">
      ↗
    </span>
  </a>

</div>