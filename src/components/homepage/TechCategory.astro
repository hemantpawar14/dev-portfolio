---
import TechBadge from "./TechBadge.astro";

interface Item {
  name: string;
  icon: string;
}

interface Props {
  title: string;
  items: Item[];
}

const { title, items } = Astro.props;
---

<div class="space-y-5">

  <h3 class="text-xl font-semibold text-white">
    {title}
  </h3>

  <div class="flex flex-wrap gap-4">
    {
      items.map((item) => (
        <TechBadge {...item} />
      ))
    }
  </div>

</div>