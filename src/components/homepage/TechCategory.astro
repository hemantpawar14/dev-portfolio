---
import TechBadge from "./TechBadge.astro";

interface Item {
  name: string;
  icon: string;
}

interface Props {
  title: string;
  items: Item[];
}

const { title, items } = Astro.props;
---

<div class="space-y-6">

  <!-- Category Title -->
  <div class="flex items-center gap-3">

    <div class="h-px flex-1 bg-slate-800"></div>

    <h3
      class="whitespace-nowrap text-lg font-semibold tracking-wide text-white sm:text-xl"
    >
      {title}
    </h3>

    <div class="h-px flex-1 bg-slate-800"></div>

  </div>

  <!-- Technology Badges -->

  <div
    class="flex flex-wrap justify-center gap-3 sm:gap-4 lg:justify-start"
  >
    {
      items.map((item) => (
        <TechBadge {...item} />
      ))
    }
  </div>

</div>