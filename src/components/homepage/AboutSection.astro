---
import { portfolio } from "../../data/portfolio";
---

<section
  id="about"
  class="container-custom py-28"
>
  <div class="grid items-center gap-16 lg:grid-cols-2">

    <!-- Left Side -->
    <div>

      <span
        class="text-sm font-semibold uppercase tracking-[0.3em] text-blue-400"
      >
        About Me
      </span>

      <h2
        class="mt-4 text-4xl font-bold text-white md:text-5xl"
      >
        Building My Career in Cloud & DevOps
      </h2>

      <p
        class="mt-8 text-lg leading-8 text-slate-400"
      >
        I'm <strong class="text-white">{portfolio.name}</strong>,
        a Computer Engineering graduate passionate about Linux,
        Cloud Computing and DevOps.

        I enjoy building practical projects,
        automating workflows,
        and documenting everything I learn.

        My goal is to become a skilled DevOps Engineer by mastering
        AWS, Docker, Kubernetes, Terraform and CI/CD.
      </p>

    </div>

    <!-- Right Side -->

    <div
      class="rounded-3xl border border-slate-800 bg-slate-900/50 p-10 backdrop-blur-sm"
    >

      <h3
        class="mb-8 text-2xl font-bold text-white"
      >
        Quick Facts
      </h3>

      <div class="space-y-5">

        <div class="flex justify-between">
          <span class="text-slate-400">Location</span>
          <span class="text-white">
            Nashik, India
          </span>
        </div>

        <div class="flex justify-between">
          <span class="text-slate-400">
            Focus
          </span>

          <span class="text-white">
            Cloud & DevOps
          </span>
        </div>

        <div class="flex justify-between">
          <span class="text-slate-400">
            Experience
          </span>

          <span class="text-white">
            Hands-on Projects
          </span>
        </div>

        <div class="flex justify-between">
          <span class="text-slate-400">
            Learning
          </span>

          <span class="text-white">
            AWS • Docker • Kubernetes
          </span>
        </div>

      </div>

    </div>

  </div>
</section>