---
import { featuredProjects } from "../../data/projects";
import ProjectCard from "../projects/ProjectCard.astro";
---

<section
  id="projects"
  class="container-custom py-20 sm:py-24 lg:py-32"
>

  <!-- Section Heading -->

  <div class="mx-auto mb-16 max-w-4xl text-center">

    <span
      class="text-xs font-semibold uppercase tracking-[0.35em] text-cyan-400 sm:text-sm"
    >
      FEATURED PROJECTS
    </span>

    <h2
      class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
    >
      Projects I'm Proud Of
    </h2>

    <p
      class="mx-auto mt-5 max-w-3xl text-base leading-7 text-slate-400 sm:text-lg sm:leading-8"
    >
      A collection of hands-on Cloud & DevOps projects showcasing Linux,
      automation, infrastructure, networking, and modern development
      practices.
    </p>

  </div>

  <!-- Projects Grid -->

  <div
    class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3"
  >

    {
      featuredProjects.map((project) => (
        <ProjectCard {...project} />
      ))
    }

  </div>

  <!-- View All Projects -->

  <div class="mt-14 text-center">

    <a
      href="/projects"
      class="inline-flex items-center rounded-xl border border-slate-700 px-6 py-3 font-medium text-white transition-all duration-300 hover:border-cyan-400 hover:bg-slate-900"
    >
      View All Projects →
    </a>

  </div>

</section>