---
import { techCategories } from "../../data/techStack";
import TechCategory from "./TechCategory.astro";
---

<section id="tech-stack" class="container-custom py-32">

  <div class="mb-20 text-center">

    <span
      class="text-sm font-semibold uppercase tracking-[0.35em] text-blue-400"
    >
      TECH STACK
    </span>

    <h2 class="mt-5 text-4xl font-bold text-white md:text-5xl">
      Technologies I Work With
    </h2>

    <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-slate-400">
      Building Cloud & DevOps solutions through hands-on projects,
      automation, infrastructure, and continuous learning.
    </p>

  </div>

  <div class="space-y-14">

    {
      techCategories.map((category) => (
        <TechCategory {...category} />
      ))
    }

  </div>

</section>