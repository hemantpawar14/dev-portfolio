---
import { techCategories } from "../../data/techStack";
import TechCategory from "./TechCategory.astro";
---

<section
  id="tech-stack"
  class="container-custom py-20 sm:py-24 lg:py-32"
>

  <!-- Section Heading -->

  <div class="mx-auto mb-16 max-w-4xl text-center lg:mb-20">

    <span
      class="text-xs font-semibold uppercase tracking-[0.35em] text-cyan-400 sm:text-sm"
    >
      TECH STACK
    </span>

    <h2
      class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:mt-5 lg:text-5xl"
    >
      Technologies I Work With
    </h2>

    <p
      class="mx-auto mt-5 max-w-3xl text-base leading-7 text-slate-400 sm:text-lg sm:leading-8 lg:mt-6"
    >
      Building Cloud & DevOps solutions through hands-on projects,
      automation, infrastructure, and continuous learning.
    </p>

  </div>

  <!-- Categories -->

  <div class="space-y-10 lg:space-y-14">

    {
      techCategories.map((category) => (
        <TechCategory {...category} />
      ))
    }

  </div>

</section>