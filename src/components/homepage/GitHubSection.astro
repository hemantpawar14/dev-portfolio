---
import { portfolio } from "../../data/portfolio";
---

<section id="github" class="container-custom py-28">

  <div class="mx-auto max-w-5xl rounded-3xl border border-slate-800 bg-slate-900/50 p-10 backdrop-blur-sm">

    <div class="text-center">

      <span class="text-sm font-semibold uppercase tracking-[0.3em] text-blue-400">
        GitHub
      </span>

      <h2 class="mt-4 text-4xl font-bold text-white md:text-5xl">
        Building in Public
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-400">
        I document my DevOps journey through repositories, hands-on projects,
        and continuous learning. Every project reflects practical experience
        and consistent improvement.
      </p>

    </div>

    <div class="mt-12 flex flex-col items-center gap-6">

      <a
        href={portfolio.github}
        target="_blank"
        class="rounded-xl bg-blue-600 px-8 py-3 text-lg font-semibold text-white transition hover:bg-blue-700"
      >
        View GitHub Profile →
      </a>

    </div>

  </div>

</section>