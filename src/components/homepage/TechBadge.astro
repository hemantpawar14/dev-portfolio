---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  icon: string;
}

const { name, icon } = Astro.props;
---

<div
  class="group flex h-14 items-center gap-3 rounded-full border border-slate-800/80 bg-slate-900/60 px-5 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400 hover:bg-slate-800/80 hover:shadow-lg hover:shadow-cyan-500/10"
>

  <Icon
    name={icon}
    class="h-5 w-5 flex-shrink-0 text-cyan-400 transition-transform duration-300 group-hover:scale-110"
  />

  <span
    class="whitespace-nowrap text-sm font-medium text-slate-200 sm:text-base"
  >
    {name}
  </span>

</div>