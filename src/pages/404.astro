---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 - Page Not Found | Hemant Pawar"
  description="The page you are looking for doesn't exist."
>

<section class="container-custom flex min-h-[80vh] items-center justify-center">

  <div class="max-w-2xl text-center">

    <!-- 404 -->

    <h1
      class="bg-gradient-to-r from-blue-400 via-cyan-300 to-violet-400 bg-clip-text text-8xl font-extrabold text-transparent md:text-9xl"
    >
      404
    </h1>

    <!-- Heading -->

    <h2 class="mt-8 text-3xl font-bold text-white md:text-5xl">
      Oops! Page Not Found
    </h2>

    <!-- Description -->

    <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-slate-400">
      The page you're looking for doesn't exist or may have been moved.
      Let's get you back to the homepage.
    </p>

    <!-- Button -->

    <div class="mt-10">

      <a
        href="/"
        class="inline-flex items-center rounded-xl bg-blue-600 px-8 py-4 font-semibold text-white transition-all duration-300 hover:-translate-y-1 hover:bg-blue-500 hover:shadow-xl hover:shadow-blue-500/30"
      >
        ← Back to Home
      </a>

    </div>

  </div>

</section>

</Layout>