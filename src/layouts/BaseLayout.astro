---
import "../styles/global.css";

import Navbar from "../components/layout/Navbar.astro";

import AuroraBackground from "../components/effects/AuroraBackground.astro";
import GridPattern from "../components/effects/GridPattern.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
  <AuroraBackground />
  <GridPattern />

  <Navbar />

  <main>
    <slot />
  </main>
</body>
</html>