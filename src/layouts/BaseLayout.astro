---
import "../styles/global.css";

import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";

import AuroraBackground from "../components/effects/AuroraBackground.astro";
import GridPattern from "../components/effects/GridPattern.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Hemant Pawar | Cloud & DevOps Engineer",
  description =
    "Cloud & DevOps Engineer passionate about Linux, AWS, Docker, Kubernetes, Terraform, GitHub Actions, and modern DevOps practices.",
} = Astro.props;
---

<!DOCTYPE html>

<html lang="en">

<head>

  <!-- Basic -->

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="author"
    content="Hemant Pawar"
  />

  <meta
    name="theme-color"
    content="#020617"
  />

  <!-- Open Graph -->

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />

  <!-- Twitter -->

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <!-- Favicon -->

  <link
    rel="icon"
    type="image/png"
    href="/favicon.png"
  />

</head>

<body
  id="top"
  class="bg-slate-950 text-white antialiased"
>

  <!-- Background Effects -->

  <AuroraBackground />

  <GridPattern />

  <!-- Navigation -->

  <Navbar />

  <!-- Main Content -->

  <main class="relative z-10 min-h-screen">

    <slot />

  </main>

  <!-- Footer -->

  <Footer />

</body>

</html>