---
import "../styles/global.css";

import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";

import AuroraBackground from "../components/effects/AuroraBackground.astro";
import GridPattern from "../components/effects/GridPattern.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Hemant Pawar | Cloud & DevOps Engineer",
  description =
    "Cloud & DevOps Engineer specializing in Linux, AWS, Docker, Kubernetes, Terraform, GitHub Actions, and modern cloud automation.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">

<head>

  <!-- Basic SEO -->
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="keywords"
    content="Hemant Pawar, Cloud Engineer, DevOps Engineer, Linux, AWS, Docker, Kubernetes, Terraform, GitHub Actions, DevOps Portfolio, Cloud Portfolio"
  />

  <meta
    name="author"
    content="Hemant Pawar"
  />

  <meta
    name="robots"
    content="index, follow"
  />

  <meta
    name="theme-color"
    content="#020617"
  />

  <!-- Uncomment after deployment -->
  <!--
  <link
    rel="canonical"
    href="https://your-domain.com"
  />
  -->

  <!-- Open Graph -->

  <meta
    property="og:type"
    content="website"
  />

  <meta
    property="og:title"
    content={title}
  />

  <meta
    property="og:description"
    content={description}
  />

  <meta
    property="og:image"
    content="/og-image.png"
  />

  <meta
    property="og:site_name"
    content="Hemant Pawar Portfolio"
  />

  <!-- Uncomment after deployment -->
  <!--
  <meta
    property="og:url"
    content="https://your-domain.com"
  />
  -->

  <!-- Twitter Card -->

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={title}
  />

  <meta
    name="twitter:description"
    content={description}
  />

  <meta
    name="twitter:image"
    content="/og-image.png"
  />

  <!-- Uncomment if you have an X (Twitter) account -->
  <!--
  <meta
    name="twitter:creator"
    content="@yourusername"
  />
  -->

  <!-- Favicon -->

  <link
    rel="icon"
    href="/favicon.ico"
  />

</head>

<body
  id="top"
  class="bg-slate-950 text-white antialiased"
>

  <!-- Background Effects -->

  <AuroraBackground />

  <GridPattern />

  <!-- Navigation -->

  <Navbar />

  <!-- Main Content -->

  <main class="relative z-10 min-h-screen">

    <slot />

  </main>

  <!-- Footer -->

  <Footer />

</body>

</html>